Bootstrap: docker
From: ros:humble-ros-base

%environment
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
    . /opt/ros/humble/setup.sh
    if [ -f /ws/install/setup.sh ]; then
        . /ws/install/setup.sh
    fi

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        libpcl-dev \
        libeigen3-dev \
        libgoogle-glog-dev \
        libgflags-dev \
        ros-humble-pcl-conversions \
        ros-humble-pcl-ros \
        ros-humble-rosbag2 \
        ros-humble-rosbag2-storage-mcap \
        python3-colcon-common-extensions \
        python3-pip \
        && rm -rf /var/lib/apt/lists/*

    pip3 install --no-cache-dir numpy scipy opencv-python rosbags

    # 1. Build & Install Livox-SDK2
    cd /tmp
    git clone --depth 1 https://github.com/Livox-SDK/Livox-SDK2.git
    cd Livox-SDK2 && mkdir build && cd build
    cmake .. -DCMAKE_BUILD_TYPE=Release
    make -j$(nproc)
    make install
    ldconfig
    rm -rf /tmp/Livox-SDK2

    # 2. Setup ROS 2 workspace
    mkdir -p /ws/src
    cd /ws/src

    # Clone livox_ros_driver2
    git clone --depth 1 https://github.com/Livox-SDK/livox_ros_driver2.git
    cd /ws/src/livox_ros_driver2
    cp -f package_ROS2.xml package.xml
    cp -rf launch_ROS2/ launch/

    # Clone FAST_LIO ROS 2
    cd /ws/src
    git clone --recurse-submodules https://github.com/Ericsii/FAST_LIO_ROS2.git fast_lio

    # Build workspace
    cd /ws
    /bin/bash -c "source /opt/ros/humble/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release -DROS_EDITION=ROS2 -DDISTRO_ROS=humble"

    # Cleanup
    rm -rf /ws/src/livox_ros_driver2/launch/
